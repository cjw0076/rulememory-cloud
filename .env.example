# RuleMemory Cloud -- environment variables (NAMES ONLY; never commit real values).
# Copy to .env for local live testing, or set these on the Cloud Run service.

# ---- Gemini reasoning ----
# Path A (simplest): Gemini Developer API key.
GEMINI_API_KEY=
# Override the model id. Default gemini-2.5-flash. Set a Gemini 3 id when your
# project has access (the hackathon references "Gemini 3").
GEMINI_MODEL=gemini-2.5-flash
# Path B (Vertex AI instead of API key): set true and supply project/location.
# On Cloud Run, ADC = the service account, so no key file is needed.
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# ---- MongoDB Atlas persistence ----
# SRV connection string from Atlas (Database > Connect > Drivers).
MONGODB_URI=
MONGODB_DB=rulememory
MONGODB_COLLECTION=entries

# ---- MongoDB MCP server (partner integration) ----
# URL of the MongoDB MCP server running with `--transport http` (default :3000).
# The server itself reads the cluster string from MDB_MCP_CONNECTION_STRING.
# Leave blank to keep the agent's MCP calls in mock mode while still writing to
# MongoDB directly via MONGODB_URI.
MONGODB_MCP_URL=

# ---- HTTP surface ----
PORT=8080
